{
  "manifest_version": 3,
  "name": "Dictopen pour Chrome",
  "version": "0.5.1",
  "description": "Relit et corrige le courrier affiché dans la page (Follow, Doctolib, tout éditeur web) avec Dictopen, puis le remplace. Le texte ne part que vers le modèle réglé dans Dictopen (OpenAI ou Anthropic), avec votre clé, identifiants reconnus masqués.",
  "key": "",
  "permissions": ["alarms", "contextMenus", "scripting", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "icons": { "128": "icon128.png" },
  "action": { "default_title": "Corriger le courrier avec Dictopen (Alt+Maj+C)", "default_icon": "icon128.png" },
  "commands": {
    "corriger": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Corriger la sélection, ou le courrier reconnu dans la page"
    }
  },
  "options_page": "options.html"
}
